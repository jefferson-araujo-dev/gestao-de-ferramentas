rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfilePath() {
      return /databases/$(database)/documents/artifacts/gestao-de-ferramentas-3f8f1/public/data/users/$(request.auth.uid);
    }

    function hasActiveProfile() {
      return signedIn()
        && exists(userProfilePath())
        && get(userProfilePath()).data.status == 'Ativo';
    }

    function isAdmin() {
      return hasActiveProfile()
        && get(userProfilePath()).data.accessLevel == 'Administrador';
    }

    // Leitura de colaboradores: qualquer perfil ativo, exceto o perfil restrito (flag
    // isRestricted gravada só pelo Admin SDK; ausente = não restrito). Administrador nunca é
    // restrito. O restrito empresta pela API de movimentação, que resolve o crachá no servidor.
    function canReadCollaborators() {
      return hasActiveProfile()
        && (isAdmin() || get(userProfilePath()).data.get('isRestricted', false) != true);
    }

    match /artifacts/gestao-de-ferramentas-3f8f1/public/data/users/{userId} {
      allow get: if signedIn()
        && (userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Empréstimo e devolução são exclusivos da API de movimentação (Admin SDK). Nenhum cliente,
    // nem o administrador, cria ferramenta emprestada, leva uma ferramenta para 'borrowed', tira
    // uma ferramenta de 'borrowed' ou altera os campos que o empréstimo grava. Editar os demais
    // dados de uma ferramenta emprestada (nome, categoria, imagem, notas...) continua permitido.
    function isBorrowed(data) {
      return data.get('status', null) == 'borrowed';
    }

    // Exatamente os campos que o empréstimo/devolução gravam (api/tools/movement.js).
    function loanFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['status', 'currentUser', 'currentCollaboratorId', 'lastAction']);
    }

    match /artifacts/gestao-de-ferramentas-3f8f1/public/data/tools/{toolId} {
      allow read: if hasActiveProfile();
      allow create: if isAdmin() && !isBorrowed(request.resource.data);
      allow update: if isAdmin()
        && (
          (!isBorrowed(resource.data) && !isBorrowed(request.resource.data))
          || (isBorrowed(resource.data) && loanFieldsUnchanged())
        );
      // Ferramenta emprestada não é excluída: o empréstimo termina só pela devolução oficial.
      allow delete: if isAdmin() && (resource == null || !isBorrowed(resource.data));
    }

    match /artifacts/gestao-de-ferramentas-3f8f1/public/data/collaborators/{collaboratorId} {
      allow read: if canReadCollaborators();
      allow write: if isAdmin();
    }

    match /artifacts/gestao-de-ferramentas-3f8f1/public/data/history/{historyId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfilePath() {
      return /databases/$(database)/documents/artifacts/gestao-de-ferramentas-3f8f1/public/data/users/$(request.auth.uid);
    }

    function hasActiveProfile() {
      return signedIn()
        && exists(userProfilePath())
        && get(userProfilePath()).data.status == 'Ativo';
    }

    function isAdmin() {
      return hasActiveProfile()
        && get(userProfilePath()).data.accessLevel == 'Administrador';
    }

    // Leitura de colaboradores: qualquer perfil ativo, exceto o perfil restrito (flag
    // isRestricted gravada só pelo Admin SDK; ausente = não restrito). Administrador nunca é
    // restrito. O restrito empresta pela API de movimentação, que resolve o crachá no servidor.
    function canReadCollaborators() {
      return hasActiveProfile()
        && (isAdmin() || get(userProfilePath()).data.get('isRestricted', false) != true);
    }

    match /artifacts/gestao-de-ferramentas-3f8f1/public/data/users/{userId} {
      allow get: if signedIn()
        && (userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // 'borrowed' só é um estado válido quando produzido pelo empréstimo oficial (Movement API,
    // Admin SDK, que não é controlada por estas Rules). Nenhum cliente — nem Admin — pode criar
    // ou levar uma ferramenta a 'borrowed' diretamente, e enquanto o documento estiver 'borrowed'
    // os campos do próprio empréstimo (status, colaborador atual, usuário atual, última ação)
    // ficam congelados: só a devolução oficial os altera. Metadados não operacionais (nome,
    // categoria, imagem, observações, manual, condição, próxima manutenção) continuam editáveis
    // normalmente mesmo com a ferramenta emprestada.
    function isBorrowed(data) {
      return data.get('status', null) == 'borrowed';
    }

    match /artifacts/gestao-de-ferramentas-3f8f1/public/data/tools/{toolId} {
      allow read: if hasActiveProfile();

      allow create: if isAdmin() && !isBorrowed(request.resource.data);

      allow update: if isAdmin() && (
        (!isBorrowed(resource.data) && !isBorrowed(request.resource.data)) ||
        (isBorrowed(resource.data) && isBorrowed(request.resource.data)
          && request.resource.data.get('currentCollaboratorId', null) == resource.data.get('currentCollaboratorId', null)
          && request.resource.data.get('currentUser', null) == resource.data.get('currentUser', null)
          && request.resource.data.get('lastAction', null) == resource.data.get('lastAction', null))
      );

      allow delete: if isAdmin() && !isBorrowed(resource.data);
    }

    match /artifacts/gestao-de-ferramentas-3f8f1/public/data/collaborators/{collaboratorId} {
      allow read: if canReadCollaborators();
      allow write: if isAdmin();
    }

    match /artifacts/gestao-de-ferramentas-3f8f1/public/data/history/{historyId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

{
  "name": "gestao-de-ferramentas-v3",
  "version": "3.0.1",
  "description": "Sistema de Gestão de Ferramentas - COENG",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:responsive": "playwright test --reporter=line",
    "test:responsive:list": "playwright test --list --reporter=line",
    "backup": "node backup-database.mjs",
    "export": "node export-firebase-data.mjs",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\""
  },
  "dependencies": {
    "dotenv": "^17.4.1",
    "firebase": "^12.12.0",
    "firebase-admin": "14.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.2.2",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.2.2",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "workbox-precaching": "^7.3.0"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "4.15.9"
    }
  }
}

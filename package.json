{
  "name": "gestao-de-ferramentas",
  "version": "3.1.0",
  "description": "Sistema de Gestão de Ferramentas",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start",
    "seed:emulator": "node scripts/seed-emulator.js",
    "test:responsive": "playwright test --reporter=line",
    "test:responsive:list": "playwright test --list --reporter=line",
    "backup": "node scripts/backup-database.mjs",
    "export": "node scripts/export-firebase-data.mjs",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\""
  },
  "dependencies": {
    "dotenv": "^17.4.1",
    "firebase": "^12.12.0",
    "firebase-admin": "14.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.2.2",
    "eslint": "^9.0.0",
    "firebase-tools": "^15.27.0",
    "globals": "^15.0.0",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.2.2",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "workbox-precaching": "^7.3.0"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "4.15.9"
    }
  }
}
